# Database connection (configured automatically by the platform)
DATABASE_URL=

# Email notifications (optional) — when both are set, a booking notification
# email is sent to CLINIC_EMAIL via the Resend API after each successful
# booking request. Booking data is always saved even if these are unset.
EMAIL_API_KEY=
CLINIC_EMAIL=

# WhatsApp contact (defaults to the verified public Molar Clinics number/link
# if left empty — see src/content/clinic.ts)
WHATSAPP_NUMBER=
WHATSAPP_LINK=

# Verified public social and map links (defaults already set in
# src/content/clinic.ts, override only if the clinic publishes new ones)
INSTAGRAM_LINK=https://www.instagram.com/molar_clinics/
GOOGLE_MAPS_URL=

# Public site URL used for metadata, sitemap and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
